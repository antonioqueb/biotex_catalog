<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reorder_wizard_form" model="ir.ui.view">
        <field name="name">biotex.reorder.wizard.form</field>
        <field name="model">biotex.reorder.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="family_id"/>
                    <field name="product_ids" widget="many2many_tags"/>
                    <field name="historical_prefix"/>
                    <field name="component"/>
                    <field name="measure_type"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Se reasignarán las claves de los productos del filtro, ordenando por componente, tipo y medida numérica.
                    La numeración continuará después del último consecutivo usado o reservado de cada clasificación; no reinicia en 01.
                    Las claves anteriores se conservan en el historial. Los códigos propios anteriores siguen identificando el producto.
                </div>
                <field name="preview"/>
                <footer>
                    <button string="Aplicar reordenamiento" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_reorder_wizard_form" model="ir.ui.view">
        <field name="name">biotex.reorder.wizard.form</field>
        <field name="model">biotex.reorder.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="family_id"/>
                </group>
                <div class="alert alert-warning" role="alert">
                    Se reasignarán las claves de toda la familia ordenando por nombre base y medida numérica.
                    Los códigos propios (QR) se actualizan; las etiquetas impresas deberán reimprimirse.
                </div>
                <field name="preview"/>
                <footer>
                    <button string="Aplicar reordenamiento" type="object" name="action_apply" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

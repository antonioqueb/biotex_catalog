<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biotex_brand_list" model="ir.ui.view">
        <field name="name">biotex.brand.list</field>
        <field name="model">biotex.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="manufacturer_id"/>
                <field name="product_count" string="Productos"/>
                <field name="created_by_id" widget="many2one_avatar_user" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_biotex_brand_form" model="ir.ui.view">
        <field name="name">biotex.brand.form</field>
        <field name="model">biotex.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Productos"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="code" placeholder="LGMD" style="width: 6em"/> <field name="name" placeholder="Nombre de la marca"/></h1>
                    </div>
                    <group>
                        <field name="manufacturer_id"/>
                        <field name="normalized_name" groups="base.group_no_one"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <field name="notes" placeholder="Notas: distribuidores, restricciones de instituciones..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biotex_brand" model="ir.actions.act_window">
        <field name="name">Marcas</field>
        <field name="res_model">biotex.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

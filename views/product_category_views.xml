<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_category_form_biotex" model="ir.ui.view">
        <field name="name">product.category.form.biotex</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pending" type="object" class="oe_stat_button" icon="fa-exclamation-circle">
                    <field name="biotex_product_pending" widget="statinfo" string="Pendientes"/>
                </button>
                <button name="action_open_reorder_wizard" type="object" class="oe_stat_button" icon="fa-sort-numeric-asc"
                        string="Reordenar" invisible="biotex_level != 'family'" groups="biotex_base.group_biotex_direction"/>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="biotex_level"/>
                <field name="biotex_code" invisible="biotex_level not in ('group', 'family')"/>
                <field name="biotex_sequence_id" invisible="biotex_level != 'family'"/>
                <field name="biotex_photo_required" invisible="biotex_level != 'family'"/>
                <field name="biotex_description_hint" invisible="biotex_level != 'family'"/>
                <field name="biotex_secondary_group_ids" widget="many2many_tags" invisible="biotex_level != 'family'"/>
                <field name="biotex_default_tax_ids" widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record id="view_category_list_biotex" model="ir.ui.view">
        <field name="name">product.category.list.biotex</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="biotex_level"/>
                <field name="biotex_code"/>
                <field name="biotex_product_total" string="Productos"/>
                <field name="biotex_product_pending" string="Pendientes"/>
            </field>
        </field>
    </record>

    <record id="action_biotex_families" model="ir.actions.act_window">
        <field name="name">Grupos y familias</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('biotex_level', 'in', ('group', 'family'))]</field>
        <field name="context" eval="{'default_parent_id': ref('product.product_category_goods')}"/>
    </record>
</odoo>

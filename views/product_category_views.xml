<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_category_form_biotex" model="ir.ui.view">
        <field name="name">product.category.form.biotex</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pending" type="object" class="oe_stat_button" icon="fa-exclamation-circle" invisible="biotex_level != 'family'">
                    <field name="biotex_product_pending" widget="statinfo" string="Pendientes"/>
                </button>
                <button name="action_open_reorder_wizard" type="object" class="oe_stat_button" icon="fa-sort-numeric-asc" string="Reordenar" invisible="biotex_level != 'family'" groups="biotex_base.group_biotex_direction"/>
            </xpath>
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="biotex_group_id"/>
                <field name="biotex_division_id" invisible="not biotex_group_id"/>
                <field name="biotex_code" invisible="not biotex_group_id"/>
                <field name="biotex_composite" invisible="not biotex_group_id"/>
                <field name="biotex_status" invisible="not biotex_group_id"/>
                <field name="biotex_classifier_ids" widget="many2many_tags" invisible="not biotex_group_id"/>
                <field name="biotex_photo_required" invisible="not biotex_group_id"/>
                <field name="biotex_description_hint" invisible="not biotex_group_id"/>
                <field name="biotex_default_tax_ids" widget="many2many_tags"/>
                <field name="biotex_origin" invisible="not biotex_group_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_category_list_biotex" model="ir.ui.view">
        <field name="name">product.category.list.biotex</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="after">
                <field name="biotex_group_id"/>
                <field name="biotex_code"/>
                <field name="biotex_status" widget="badge" decoration-success="biotex_status == 'active'" decoration-warning="biotex_status == 'proposed'" decoration-muted="biotex_status == 'pending'"/>
                <field name="biotex_classifier_ids" widget="many2many_tags" optional="show"/>
                <field name="biotex_product_total" string="Productos"/>
                <field name="biotex_product_pending" string="Pendientes"/>
            </field>
        </field>
    </record>

    <record id="view_category_search_biotex" model="ir.ui.view">
        <field name="name">product.category.search.biotex</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="biotex_code"/>
                <field name="biotex_group_id"/>
                <filter name="families" string="Familias" domain="[('biotex_level', '=', 'family')]"/>
                <filter name="group_by_group" string="Grupo" context="{'group_by': 'biotex_group_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="action_biotex_families" model="ir.actions.act_window">
        <field name="name">Familias</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('biotex_level', '=', 'family')]</field>
        <field name="context" eval="{'default_parent_id': ref('product.product_category_goods'), 'search_default_group_by_group': 1}"/>
    </record>
</odoo>

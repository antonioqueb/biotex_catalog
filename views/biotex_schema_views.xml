<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grupos -->
    <record id="view_group_list" model="ir.ui.view">
        <field name="name">biotex.group.list</field>
        <field name="model">biotex.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="division_id"/>
                <field name="classifier_axis"/>
                <field name="regulated" widget="boolean_toggle"/>
                <field name="family_count" string="Familias"/>
                <field name="classifier_count" string="Clasificadores"/>
                <field name="product_count" string="Productos"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>
    <record id="view_group_form" model="ir.ui.view">
        <field name="name">biotex.group.form</field>
        <field name="model">biotex.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes"><field name="product_count" widget="statinfo" string="Productos"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="code" placeholder="CE"/> <field name="name" placeholder="Consumible de equipo médico"/></h1></div>
                    <group>
                        <group>
                            <field name="division_id"/>
                            <field name="classifier_axis" placeholder="Equipo destino / tipo de artículo / forma farmacéutica"/>
                            <field name="regulated"/>
                        </group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="tag_id"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Familias"><field name="family_ids" context="{'default_biotex_group_id': id}"><list><field name="biotex_code"/><field name="name"/><field name="biotex_status"/><field name="biotex_product_total" string="Productos"/></list></field></page>
                        <page string="Clasificadores"><field name="classifier_ids" context="{'default_group_id': id}"><list editable="bottom"><field name="code"/><field name="name"/><field name="status"/><field name="family_ids" widget="many2many_tags"/></list></field></page>
                        <page string="Notas"><field name="note"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_biotex_group" model="ir.actions.act_window">
        <field name="name">Divisiones y grupos</field>
        <field name="res_model">biotex.group</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_division': 1}</field>
    </record>
    <record id="view_group_search" model="ir.ui.view">
        <field name="name">biotex.group.search</field>
        <field name="model">biotex.group</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><group><filter name="group_division" string="División" context="{'group_by': 'division_id'}"/></group></search>
        </field>
    </record>

    <!-- Clasificadores -->
    <record id="view_classifier_list" model="ir.ui.view">
        <field name="name">biotex.classifier.list</field>
        <field name="model">biotex.classifier</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="group_id"/>
                <field name="code"/>
                <field name="name"/>
                <field name="axis"/>
                <field name="status" widget="badge" decoration-success="status == 'active'" decoration-warning="status == 'proposed'" decoration-muted="status == 'pending'"/>
                <field name="family_ids" widget="many2many_tags" domain="[('biotex_group_id', '=', group_id)]"/>
                <field name="product_count" string="Productos"/>
            </list>
        </field>
    </record>
    <record id="view_classifier_search" model="ir.ui.view">
        <field name="name">biotex.classifier.search</field>
        <field name="model">biotex.classifier</field>
        <field name="arch" type="xml">
            <search><field name="name"/><field name="code"/><field name="group_id"/>
                <filter name="active_status" string="Activos" domain="[('status', '=', 'active')]"/>
                <filter name="proposed" string="Propuestas y pendientes" domain="[('status', '!=', 'active')]"/>
                <group><filter name="group_group" string="Grupo" context="{'group_by': 'group_id'}"/></group></search>
        </field>
    </record>
    <record id="action_biotex_classifier_list" model="ir.actions.act_window">
        <field name="name">Clasificadores</field>
        <field name="res_model">biotex.classifier</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_group_group': 1}</field>
    </record>

    <!-- Especialidades y subclases -->
    <record id="view_specialty_list" model="ir.ui.view">
        <field name="name">biotex.specialty.list</field>
        <field name="model">biotex.specialty</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="code"/><field name="name"/><field name="active" widget="boolean_toggle"/></list></field>
    </record>
    <record id="action_biotex_specialty" model="ir.actions.act_window">
        <field name="name">Especialidades clínicas</field>
        <field name="res_model">biotex.specialty</field>
        <field name="view_mode">list</field>
    </record>
    <record id="view_subclass_list" model="ir.ui.view">
        <field name="name">biotex.mt.subclass.list</field>
        <field name="model">biotex.mt.subclass</field>
        <field name="arch" type="xml"><list editable="bottom"><field name="family_id"/><field name="code"/><field name="name"/></list></field>
    </record>
    <record id="action_biotex_subclass" model="ir.actions.act_window">
        <field name="name">Subclases terapéuticas (MT)</field>
        <field name="res_model">biotex.mt.subclass</field>
        <field name="view_mode">list</field>
        <field name="context">{'group_by': 'family_id'}</field>
    </record>

    <!-- Genéricos -->
    <record id="view_generic_list" model="ir.ui.view">
        <field name="name">biotex.generic.list</field>
        <field name="model">biotex.generic</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="measure"/>
                <field name="group_id"/>
                <field name="family_id"/>
                <field name="classifier_id"/>
                <field name="product_count" string="Marcas"/>
            </list>
        </field>
    </record>
    <record id="view_generic_form" model="ir.ui.view">
        <field name="name">biotex.generic.form</field>
        <field name="model">biotex.generic</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="code" readonly="1"/></h1><h2><field name="name" placeholder="Electrodo de broche para ECG redondo"/></h2></div>
                    <group>
                        <group><field name="family_id"/><field name="classifier_id" domain="[('family_ids', 'in', [family_id])]"/></group>
                        <group><field name="group_id"/><field name="measure"/></group>
                    </group>
                    <notebook>
                        <page string="Presentaciones por marca"><field name="product_ids"><list><field name="default_code"/><field name="biotex_brand_id"/><field name="name"/><field name="biotex_reference"/><field name="list_price"/><field name="biotex_class_state" widget="biotex_class_badge"/></list></field></page>
                        <page string="Notas"><field name="notes"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_biotex_generic" model="ir.actions.act_window">
        <field name="name">Genéricos (equivalencias entre marcas)</field>
        <field name="res_model">biotex.generic</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_family': 1}</field>
    </record>
    <record id="view_generic_search" model="ir.ui.view">
        <field name="name">biotex.generic.search</field>
        <field name="model">biotex.generic</field>
        <field name="arch" type="xml">
            <search><field name="code"/><field name="name"/><group><filter name="group_family" string="Familia" context="{'group_by': 'family_id'}"/><filter name="group_group" string="Grupo" context="{'group_by': 'group_id'}"/></group></search>
        </field>
    </record>

    <record id="view_package_type_list" model="ir.ui.view">
        <field name="name">biotex.package.type.list</field>
        <field name="model">biotex.package.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_biotex_package_type" model="ir.actions.act_window">
        <field name="name">Tipos de empaque</field>
        <field name="res_model">biotex.package.type</field>
        <field name="view_mode">list</field>
    </record>
</odoo>

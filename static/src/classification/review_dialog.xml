<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="biotex_catalog.ClassificationReviewDialog">
        <Dialog title="'Revisar y generar claves'" size="'lg'" contentClass="'o_bcw_modal o_bcw_review_modal'">
            <div class="o_bcw_modal_body">
                <p class="mb-0">Se aplicarán los nombres, unidades y referencias de <strong t-esc="props.preview.count"/> productos. Se conservará su identidad y el historial de clasificación.</p>
                <div t-if="props.preview.kept_uoms and props.preview.kept_uoms.length" class="alert alert-info mb-0" role="status">
                    <i class="fa fa-lock me-2" aria-hidden="true"/>
                    <strong t-esc="props.preview.kept_uoms.length"/> producto(s) conservan su unidad indivisible porque ya tienen movimientos de inventario:
                    <ul class="mb-0 mt-1">
                        <li t-foreach="props.preview.kept_uoms" t-as="k" t-key="k.id"><t t-esc="k.name"/>: se conserva <strong t-esc="k.kept"/> (se había indicado <t t-esc="k.requested"/>). Registra el empaque como empacado con su equivalencia.</li>
                    </ul>
                </div>
                <t t-if="props.preview.changes.length">
                    <div class="alert alert-warning mb-0" role="alert">
                        <i class="fa fa-exclamation-triangle me-2" aria-hidden="true"/>
                        <strong t-esc="props.preview.changes.length"/> productos ya tienen una referencia que cambiará. Revisa cada cambio antes de continuar.
                    </div>
                    <div t-if="reclassified.length" class="alert alert-danger mb-0" role="alert">
                        <i class="fa fa-exclamation-circle me-2" aria-hidden="true"/>
                        <strong t-esc="reclassified.length"/> producto(s) <strong>ya clasificados con otra clave completa</strong> se mueven a esta clasificación (en rojo): recibirán una clave nueva y su numeración actual cambiará.
                    </div>
                    <div class="o_bcw_review_scroll" role="region" aria-label="Referencias que cambiarán" tabindex="0">
                        <table class="table table-sm o_list_table mb-0">
                            <thead><tr><th>Producto</th><th>Referencia anterior</th><th>Referencia nueva</th></tr></thead>
                            <tbody>
                                <tr t-foreach="props.preview.changes" t-as="change" t-key="change.id" t-att-class="{ 'table-danger': change.reclassified }">
                                    <td><t t-esc="change.name"/><span t-if="change.reclassified" class="badge text-bg-danger ms-2">Cambia de clasificación</span></td>
                                    <td class="o_bcw_mono" t-esc="change.before"/><td class="o_bcw_mono" t-esc="change.after"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <label class="form-check mb-0">
                        <input class="form-check-input" type="checkbox" t-model="state.acknowledged" t-att-disabled="state.saving"/>
                        <span class="form-check-label">Revisé las referencias anteriores<t t-if="reclassified.length"> y acepto que los productos en rojo cambien de clasificación y de numeración</t>. Confirmo esta reclasificación.</span>
                    </label>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="confirm" t-att-disabled="state.saving or (props.preview.changes.length and !state.acknowledged)">Generar claves</button>
                <button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.saving">Volver a revisar</button>
            </t>
        </Dialog>
    </t>
</templates>

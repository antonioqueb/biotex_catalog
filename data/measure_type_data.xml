<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- 09_DIM_ATRIBUTO_TIPO: 7 tipos del bloque ATRIBUTO del esquema y 5 propuestos que las medidas reales exigen. -->
    <record id="measure_type_cal" model="biotex.measure.type"><field name="code">CAL</field><field name="name">CALIBRE</field><field name="description">Grosor en sistemas médicos (agujas, suturas, sondas).</field><field name="typical_units">GA, FR, USP, MM</field><field name="origin">schema</field><field name="sequence">10</field></record>
    <record id="measure_type_dia" model="biotex.measure.type"><field name="code">DIA</field><field name="name">DIAMETRO</field><field name="description">Ancho de objetos circulares (electrodos redondos, sondas).</field><field name="typical_units">MM, CM, FR</field><field name="origin">schema</field><field name="sequence">20</field></record>
    <record id="measure_type_lar" model="biotex.measure.type"><field name="code">LAR</field><field name="name">LARGO</field><field name="description">Longitud mayor (cables, agujas, guías, sondas, vendas).</field><field name="typical_units">CM, MT, MM</field><field name="origin">schema</field><field name="sequence">30</field></record>
    <record id="measure_type_anc" model="biotex.measure.type"><field name="code">ANC</field><field name="name">ANCHO</field><field name="description">Dimensión horizontal de productos planos (parches, telas).</field><field name="typical_units">CM, MM</field><field name="origin">schema</field><field name="sequence">40</field></record>
    <record id="measure_type_vol" model="biotex.measure.type"><field name="code">VOL</field><field name="name">VOLUMEN</field><field name="description">Capacidad de líquidos (geles, aceites, soluciones).</field><field name="typical_units">ML, LT</field><field name="origin">schema</field><field name="sequence">50</field></record>
    <record id="measure_type_geo" model="biotex.measure.type"><field name="code">GEO</field><field name="name">GEOMETRIA</field><field name="description">Forma física (redondo, cuadrado, oval).</field><field name="typical_units">ND</field><field name="origin">schema</field><field name="sequence">60</field></record>
    <record id="measure_type_res" model="biotex.measure.type"><field name="code">RES</field><field name="name">RESISTENCIA</field><field name="description">Carga o soporte mecánico (peso bariátrico).</field><field name="typical_units">KG</field><field name="origin">schema</field><field name="sequence">70</field></record>
    <record id="measure_type_alt" model="biotex.measure.type"><field name="code">ALT</field><field name="name">ALTURA</field><field name="description">Dimensión vertical de equipo y mobiliario.</field><field name="typical_units">CM, MM</field><field name="origin">proposed</field><field name="sequence">80</field></record>
    <record id="measure_type_esp" model="biotex.measure.type"><field name="code">ESP</field><field name="name">ESPESOR</field><field name="description">Grosor de productos planos (parches, placas, láminas).</field><field name="typical_units">MM</field><field name="origin">proposed</field><field name="sequence">90</field></record>
    <record id="measure_type_pes" model="biotex.measure.type"><field name="code">PES</field><field name="name">PESO</field><field name="description">Peso neto del contenido (pastas, geles en gramos).</field><field name="typical_units">GR, KG</field><field name="origin">proposed</field><field name="sequence">100</field></record>
    <record id="measure_type_tal" model="biotex.measure.type"><field name="code">TAL</field><field name="name">TALLA</field><field name="description">Talla comercial no numérica (chico, mediano, grande).</field><field name="typical_units">ND</field><field name="origin">proposed</field><field name="sequence">110</field></record>
    <record id="measure_type_pmi" model="biotex.measure.type"><field name="code">PMI</field><field name="name">POROSIDAD</field><field name="description">Tamaño de poro de filtros y membranas.</field><field name="typical_units">MIC</field><field name="origin">proposed</field><field name="sequence">120</field></record>
</odoo>
